<?xml version="1.0" encoding="utf-8"?>
<!--
    明文 HTTP 只对这几个地址开放，其余一律禁止（与 android:usesCleartextTraffic="false" 保持一致）：
      - 10.0.2.2 / 10.0.2.3：模拟器里指向宿主机的特殊地址，用于本地 WebDAV 端到端验证；
      - localhost：机内回环，便于自建 Nextcloud/WebDAV 时用 adb reverse 映射。
    真实云盘（坚果云、Nextcloud 等）一律走 HTTPS，不受此文件影响。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.2.3</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
